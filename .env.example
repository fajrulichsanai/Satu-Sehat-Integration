# Database (MySQL). No default password is applied — the app refuses to
# start without DB_PASSWORD set.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dental_clinic

# JWT signing secret. No default is applied — the app refuses to start
# without this set. Use a long random value in every environment.
JWT_SECRET=

# Super admin account seeded on first run. No default password is applied —
# the seed script throws if SUPER_ADMIN_PASSWORD is unset.
SUPER_ADMIN_EMAIL=superadmin@apexrecord.local
SUPER_ADMIN_PASSWORD=

# Encrypts patient NIK / mother's NIK at rest (AES-256-CBC) and derives the
# HMAC "blind index" used for NIK search/duplicate checks. No default is
# applied — the app refuses to start without this set. Changing this value
# after data has been encrypted makes that data unreadable, so back it up
# somewhere safe (a secret manager, not source control).
PATIENT_DATA_ENCRYPTION_KEY=

# Encrypts each user's TOTP MFA secret at rest. No default is applied — MFA
# setup/login fails without this set. Changing this value after a user has
# enabled MFA locks them out (their stored secret becomes undecryptable) —
# back it up somewhere safe, same as PATIENT_DATA_ENCRYPTION_KEY.
MFA_ENCRYPTION_KEY=

# Object storage S3-compatible (idCloudHost IS3) — dipakai untuk upload
# gambar (mis. logo/foto klinik). Isi nilai asli hanya di .env server,
# JANGAN commit nilai asli ke repo.
S3_ENDPOINT=https://is3.cloudhost.id
S3_BUCKET=apex-record
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
